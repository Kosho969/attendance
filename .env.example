# Copy to .env and edit. .env is gitignored and excluded from the Docker build
# context; the value below reaches the bundle as a build arg instead.

# Base URL of the API, including the /api prefix, with no trailing slash.
# Vite inlines this at BUILD time, so changing it requires
# `docker compose up -d --build web` — a restart will not pick it up.
#   local:      http://localhost:7400/api
#   production: https://python-api.ccti.gt/api
VITE_API_URL=http://localhost:7400/api

# Host port the reverse proxy forwards python.ccti.gt to.
WEB_PORT=8400

# Interface to publish on. Leave as the loopback default when the reverse proxy
# runs on this same host; set 0.0.0.0 only if it does not.
#WEB_BIND=127.0.0.1
